{
  "name": "onebrain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private company knowledge base — runs on your own server",
  "scripts": {
    "migrate": "node bin/migrate.mjs up",
    "migrate:status": "node bin/migrate.mjs status",
    "migrate:verify": "node bin/migrate.mjs verify",
    "test": "node --test \"test/*.test.mjs\"",
    "gate": "bash scripts/no-hosh.sh all && bash scripts/test-gate.sh",
    "start": "node src/server.mjs"
  },
  "dependencies": {
    "pg": "^8.20.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  }
}
