# ONE Brain — Konfiguration.
#
# install.sh erzeugt daraus eine .env mit generierten Passwoertern (chmod 600).
# Diese Datei enthaelt nur Namen und Defaults, niemals Werte.

# ── Wer ──────────────────────────────────────────────────────────────────────
ONEBRAIN_COMPANY="Acme GmbH"
ONEBRAIN_SLUG=acme
ONEBRAIN_DOMAIN=brain.acme.example
ONEBRAIN_ACME_EMAIL=ops@acme.example

# ── Datenbank ────────────────────────────────────────────────────────────────
POSTGRES_DB=onebrain
POSTGRES_USER=onebrain
# Von install.sh erzeugt (openssl rand -base64 32). Nie von Hand setzen.
POSTGRES_PASSWORD=

# ── Volltextsuche ────────────────────────────────────────────────────────────
# Postgres-Textsuch-Konfiguration fuer den Keyword-Arm der Hybrid-Suche.
# Beim Start gegen pg_ts_config geprueft.
#
# Achtung, stiller Fehler: eine falsche Sprache wirft KEINEN Fehler — der
# Keyword-Arm findet nur schlechter. Passend zur Hauptsprache der Dokumente
# setzen, nicht zur Sprache der Bedienoberflaeche.
ONEBRAIN_FTS_LANGUAGE=german

# ── Embeddings ───────────────────────────────────────────────────────────────
# Laeuft lokal via Ollama. 768 Dimensionen sind im Schema fest verdrahtet
# (vector(768)) — ein Modellwechsel mit anderer Dimension erfordert eine
# Migration, nicht nur eine Env-Aenderung.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_URL=http://ollama:11434
